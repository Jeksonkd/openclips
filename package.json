{
  "name": "openclips-engine",
  "version": "0.1.0",
  "description": "Local desktop NLE engine (OpenClips): multi-track timeline, WebGL color grading, keyframes, ffmpeg export.",
  "main": "src/main/main.js",
  "author": "openclips",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win zip"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.openclipsengine",
    "productName": "OpenClips",
    "asar": true,
    "files": [
      "src/**/*",
      "!node_modules/ffmpeg-static/ffmpeg",
      "!node_modules/ffprobe-static/bin/**/*"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "extraResources": [
        { "from": "node_modules/ffmpeg-static/ffmpeg", "to": "ffmpeg" },
        { "from": "node_modules/ffprobe-static/bin/linux/x64/ffprobe", "to": "ffprobe" }
      ]
    },
    "win": {
      "target": ["zip"],
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "extraResources": [
        { "from": "resources/win/ffmpeg.exe", "to": "ffmpeg.exe" },
        { "from": "resources/win/ffprobe.exe", "to": "ffprobe.exe" }
      ]
    }
  }
}
